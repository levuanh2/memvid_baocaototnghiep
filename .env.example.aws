# StudyMap AI — AWS EC2 production environment template.
#
# On the server: copy this to /opt/memvid/env/.env, fill in real values,
# `chmod 600`. Never commit the filled-in file — this template holds no
# real secrets, only the key names and safe defaults.
#
# Values mirror render.yaml's production posture: remote AI only (FPT AI +
# Gemini), no Ollama, no local embedding/reranker/NLI — same behavior the
# app has on Render today, not docker-compose.yml's local-model dev defaults.
# Render-only variables (DATA_DIR=/tmp/..., Render's own PORT injection) and
# dev/test-only variables (TEST_DATABASE_URL, COMPOSE_PROFILES, etc.) are
# deliberately not included here.

# --- Server ---
PORT=8080
DATA_DIR=/app
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120

# --- CORS ---
# "*" matches current Render behavior. Tighten to the real domain once DNS is live.
CORS_ORIGINS=*

# --- Database (Supabase Postgres) ---
DATABASE_URL=
# Migration guard (shared/migration_guard.py) — must name the real prod host/db
# explicitly before `alembic upgrade head` is allowed to run against it.
ALEMBIC_PRODUCTION_HOST=
ALEMBIC_PRODUCTION_DB=

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Auth (Bearer token) ---
AUTH_SECRET=
AUTH_REQUIRE_SECRET=true
AUTH_PROTECT_APP_APIS=true
AUTH_TOKEN_TTL_SEC=604800

# --- AI: Gemini (chat) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- AI: FPT AI (embedding + rerank; can also serve chat) ---
FPT_AI_API_KEY=
FPT_AI_BASE_URL=
FPT_AI_CHAT_MODEL=
FPT_AI_EMBEDDING_MODEL=Vietnamese_Embedding
FPT_AI_RERANK_MODEL=bge-reranker-v2-m3

# --- AI: Groq (optional fallback provider) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=

# --- No Ollama, no local models (do not remove — llm_factory only drops
# Ollama from the provider chain when OLLAMA_HOST is truly blank) ---
OLLAMA_HOST=
OLLAMA_WARMUP=0
SKIP_MODEL_LOAD=1
RERANK_ENABLED=1
RERANK_BACKEND=fpt
NLI_ENABLED=0
LATE_CHUNKING=0
EMBEDDING_WARMUP_ENABLED=0

# --- Retrieval index persistence ---
INDEX_PERSISTENCE_ENABLED=1
INGEST_ORIGIN=production
HYBRID_TOP_K=6
CRAG_ENABLED=0
HITL_ENABLED=0

# --- No Redis in this deployment — cache/queue fail open ---
REDIS_URL=
QUEUE_ENABLED=false
CONVERSATION_CONTEXT_ENABLED=true

# --- Local data paths (bind-mounted host dirs — see docker-compose.prod.yml) ---
JOBS_DB_PATH=/app/memory/jobs.sqlite
LOG_DB_PATH=/app/memory/logs.sqlite
CONVERSATIONS_DB_PATH=/app/memory/conversations.sqlite
USERS_DB_PATH=/app/memory/users.sqlite

# --- Frontend build-time only (consumed by `docker compose build`, not by the
# running containers — changing this requires a frontend image rebuild) ---
VITE_API_BASE=https://yourdomain.com

# --- TLS (scripts/bootstrap-tls.sh, scripts/renew-tls.sh) ---
# CERTBOT_DOMAIN must match the domain VITE_API_BASE points at.
CERTBOT_DOMAIN=yourdomain.com
CERTBOT_EMAIL=
