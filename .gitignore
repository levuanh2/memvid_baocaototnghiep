# FAISS index (rebuildable)
BE/index/
# Index dựng lại và các bản lưu của nó: artifact nhị phân, sinh lại được từ
# Postgres + allowlist, và bản chuẩn đã nằm trên Supabase Storage.
BE/index_*/
BE/memory/
BE/videos/
BE/input_docs/

# Runtime data store (canonical, rebuildable — not source)
data/

# Temp test data
TMP_TEST_DATA*/

# Personal Obsidian checkpoint memory
00_Active_Plans/
02_Session_Logs/
05_Debug_Logs/
06_Resume_States/

# Rác sinh ra lúc chạy test (pytest tmpdir rơi ra thư mục gốc)
pytest-cache-files-*/

# Cấu hình MCP của Claude Code — công cụ cá nhân, không phải mã dự án.
# Chứa project_ref Supabase; không phải secret nhưng không cần nằm trong git.
.mcp.json

# Output của bước làm sạch tài liệu (sinh lại được từ input_docs)
BE/cleaned_md/

# Báo cáo NCKH + dữ liệu thực nghiệm đi kèm — thuộc dự án báo cáo riêng,
# không phải mã nguồn StudyMap. File vẫn nằm trên đĩa, chỉ không theo git.
# Test đọc reports/evaluation/datasets/corpus_v1 sẽ tự skip khi thiếu.
reports/
