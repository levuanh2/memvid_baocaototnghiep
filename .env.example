# ============================================================
# MemVid — Docker Compose runtime configuration
# ============================================================
# Copy to .env for local runs:  Copy-Item .env.example .env
# Do NOT commit .env (it is .gitignored). Never put real secrets here.
# docker-compose.yml reads these as ${VAR:-default}; unset = safe default.
# ============================================================
# ------------------------------------------------------------
# HAI HỒ SƠ, KHÔNG PHẢI HAI BẢN SAO.
#   .env         (file này)  -> hồ sơ DOCKER/PROD. docker-compose.yml thay thế
#                               102 chỗ ${VAR} từ đây. Vì vậy OLLAMA_HOST trỏ
#                               host.docker.internal, REDIS_URL trỏ service `redis`,
#                               QUEUE_ENABLED=true — KHÁC BE/.env là CỐ Ý.
#   BE/.env                  -> hồ sơ DEV trên máy. Chạy `python app/main.py`.
# Khi CẢ HAI cùng khai một khoá thì **BE/.env THẮNG** —
# shared/env_loader.load_project_env nạp BE/.env trước với override=False.
# Đặt giá trị an toàn ở BE/.env, đừng đặt ở đây rồi tưởng nó có hiệu lực.
# ------------------------------------------------------------

# Docker Compose project
COMPOSE_PROJECT_NAME=memvid_auth_smoke
COMPOSE_PROFILES=worker

# Auth
AUTH_SECRET=change-me-in-local-env
AUTH_REQUIRE_SECRET=true
AUTH_TOKEN_TTL_SEC=604800
AUTH_PROTECT_APP_APIS=false
USERS_DB_PATH=/app/memory/users.sqlite

# Conversation
CONVERSATION_CONTEXT_ENABLED=true
CONVERSATIONS_DB_PATH=/app/memory/conversations.sqlite

# Queue / worker
QUEUE_ENABLED=true
QUEUE_DEPTH_MAX=20
RQ_JOB_TIMEOUT_SEC=1800
WORKER_CONCURRENCY=1
JOBS_DB_PATH=/app/memory/jobs.sqlite
LOG_DB_PATH=/app/memory/logs.sqlite

# Ollama / models
OLLAMA_HOST=http://host.docker.internal:11434
SLM_MODEL_CHAT=qwen2.5:7b-instruct
SLM_MODEL=qwen2.5:7b-instruct
MINDMAP_MODEL=qwen2.5:7b-instruct
SLM_MODEL_SUMMARY=qwen2.5:7b-instruct
OLLAMA_REASONING=0
LLM_MAX_TOKENS=8192
MAX_CONCURRENT_LLM_CALLS=1
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=180
# PR#4 query-priority lanes (gateway): batch (summary/mindmap) chi duoc dung
# MAX_CONCURRENT_LLM_CALLS - LLM_RESERVED_QUERY_SLOTS slot; query ("answer")
# dung slot reserve. Mac dinh OFF = hanh vi cu. Bat thu o staging truoc.
LLM_PRIORITY_LANES_ENABLED=false
LLM_RESERVED_QUERY_SLOTS=1
# In-process cap khi khong co gateway (LLM_GATEWAY_ADDR unset). Mac dinh ON.
LLM_INPROCESS_CAP_ENABLED=1

# PR#5 model warmup: warm TAT CA model da cau hinh (chat/summary/mindmap, dedupe,
# tuan tu, chay nen, fail-open). Model list lay tu chinh _model_map runtime —
# khong con default hardcode rieng o warmup.
OLLAMA_WARMUP=1
MODEL_WARMUP_TIMEOUT_SECONDS=120
# Embedding warmup (bge-m3 ~2GB nap RAM MOI gunicorn worker) — opt-in.
EMBEDDING_WARMUP_ENABLED=0

# Summary / mindmap timeouts
SUMMARY_LLM_TIMEOUT_SEC=300
MINDMAP_LLM_TIMEOUT_SEC=300
SUMMARY_PARALLEL=2

# Retrieval / embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
# PR#6: prefix-embedding legacy trong index.json (embed lan 2 moi chunk, phinh
# file; pipeline that khong doc). Mac dinh OFF — bat lai neu can hanh vi cu.
STORE_PREFIX_EMBEDDINGS=0
LATE_CHUNKING=1
HYBRID_TOP_K=6
USE_LC_VECTOR_STORE=1
USE_LC_QA_CHAIN=1
USE_LC_ENSEMBLE=1
USE_LC_INGEST=1

# Full query/retrieval pipeline (default research configuration)
CRAG_ENABLED=1
CRAG_REWRITE_MAX=2
RERANK_ENABLED=1
RERANK_BACKEND=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=20
RERANK_TOP_N=0
RERANK_BATCH=16
# Đo 2026-09-01 trên chunk THẬT của kho này (TB 314 ký tự, p95 496), bge-reranker-v2-m3
# trên CPU: k=5 1.70s · k=10 3.58s · k=15 5.71s · k=20 7.56s · k=30 11.51s.
# Tuyến tính ~0.38s/ứng viên; chunk dài gấp 3 thì chậm gấp ~1.7 (đo cũ: 979 ký tự,
# k=20 = 12.95s). Hạn 10s cũ bị chạm ở ~26 ứng viên — quá sát, và timeout ở đây là
# thời gian VỨT ĐI hoàn toàn (hết giờ thì rơi về thứ tự gốc, không đổi gì).
# Nâng hạn thay vì giảm RERANK_CANDIDATE_K: pool hẹp làm rerank mất tác dụng
# (lessons-learned "Rerank cần candidate pool RỘNG ở Stage 1").
RERANK_TIMEOUT_SEC=15
NLI_ENABLED=1
# Đổi model 2026-09-01. Đo trên CPU máy này, batch 2, một lượt forward:
#   mDeBERTa-v3-base (279M, 12 lớp) : 128t 39.6s · 256t 69.4s · 512t 137.5s
#   MiniLMv2-L6      (107M,  6 lớp) : 128t 0.05s · 256t 0.09s · 512t 0.18s
# Nhanh hơn 764 lần trong khi chỉ ít hơn 2.6 lần tham số — đúng chẩn đoán cũ:
# nút thắt là gather/index tuần tự của attention tách rời DeBERTa-v3, không phải FLOP.
# Một truy vấn (NLI_MAX_PAIRS=3 x 512 token): 412.5s -> 0.5s.
# Chất lượng (6 cặp tiếng Việt CÓ DẤU): mâu thuẫn 0.997/0.992/0.997, kéo theo 0.002,
# trung lập 0.019/0.178 -> ngưỡng 0.6 nằm gọn trong khoảng trống, không cần chỉnh.
NLI_MODEL=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
NLI_CONTRADICTION_THRESHOLD=0.6
# 90s cũ là hạn cho model chậm 137s/lượt. Giờ 3 cặp mất ~0.5s nên hạn
# gấp 30 lần thời gian thật vẫn quá rộng để còn là một hàng rào.
NLI_TIMEOUT_SEC=15
NLI_MAX_PAIRS=3
HITL_ENABLED=1
INCLUDE_CHUNK_SOURCE_TAGS=1

# Cache
REDIS_URL=redis://redis:6379/0
CACHE_ENV=prod
SINGLE_FLIGHT_ENABLED=true
SINGLE_FLIGHT_LOCK_TTL_SECONDS=180
SINGLE_FLIGHT_WAIT_SECONDS=120
SINGLE_FLIGHT_POLL_INTERVAL_SECONDS=0.5
SEMANTIC_CACHE_ENABLED=true

# Rate limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SCOPE=ip
RATE_LIMIT_REQUIRE_REDIS=false
ADMISSION_RETRY_AFTER_SECONDS=5

# ===== SUPABASE (Postgres + Storage) =====
# Nguồn lưu trữ nghiệp vụ chính của StudyMap AI (19 bảng quan hệ).
# BE Python nối qua SQLAlchemy/Alembic; FE KHÔNG gọi thẳng Supabase.
# Lấy giá trị ở Supabase Dashboard > Settings > API Keys và > Database.
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project_ref>.supabase.co
# Publishable key (công khai được, dùng cho client)
SUPABASE_PUBLISHABLE_KEY=
# Secret key — BÍ MẬT. Chỉ đặt trong .env thật, không bao giờ commit,
# không bao giờ gửi xuống frontend.
SUPABASE_SECRET_KEY=
# Bucket chứa file tài liệu upload; documents.file_path trỏ vào bucket này
SUPABASE_STORAGE_BUCKET=documents

# Connection string Postgres.
# Alembic migration: session pooler (port 5432) hoặc direct connection.
# App runtime: transaction pooler (port 6543) cho nhiều connection ngắn.
DATABASE_URL=postgresql+psycopg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Thiet bi chay model PyTorch ---
# Mac dinh cpu. May co GPU thi dat cuda de tang toc RAT nhieu: do duoc NLI
# mDeBERTa 298 giay/truy van tren CPU, va nut that la cong viec DON LUONG
# (16 luong chi nhanh hon 10%), dung loai viec GPU nuot gon.
#
# CAN torch ban CUDA. requirements.txt ghim torch+cpu CO CHU DICH cho Docker,
# nen phai cai rieng vao venv:
#   BE/.venv/Scripts/python.exe -m pip install torch==2.5.1+cu124 \
#     --index-url https://download.pytorch.org/whl/cu124
#
# Luu y VRAM: bge-m3 ~2.3GB + bge-reranker ~2.2GB + mDeBERTa ~1.1GB = ~5.6GB.
# Tren card 6GB thi Ollama PHAI o CPU, khong chung duoc.
# Gia tri: cpu | cuda | cuda:N | auto
TORCH_DEVICE=cpu
